# Copy this file to ".env" and fill in your own values
# NEVER commit the real ".env" file to GitHub

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local example:      mongodb://127.0.0.1:27017/portfolioDB
# Atlas (cloud) example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolioDB
MONGO_URI=mongodb://127.0.0.1:27017/portfolioDB

# Comma separated list of allowed frontend origins (for CORS)
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000
